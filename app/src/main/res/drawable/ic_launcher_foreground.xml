<?xml version="1.0" encoding="utf-8"?>
<!-- Hexagon achievement badge with a W monogram and a sparkle,
     kept inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- badge -->
    <path
        android:fillColor="#10150B"
        android:pathData="M54,22 L82,38 V70 L54,86 L26,70 V38 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="22"
                android:endX="82" android:endY="86">
                <item android:offset="0" android:color="#FFD4F57A" />
                <item android:offset="0.5" android:color="#FF9DC93B" />
                <item android:offset="1" android:color="#FF4F7A12" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- W -->
    <path
        android:pathData="M38,44 L46,67 L54,52 L62,67 L70,44"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="7">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="44"
                android:endX="54" android:endY="67">
                <item android:offset="0" android:color="#FFD4F57A" />
                <item android:offset="1" android:color="#FF7DAA22" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- sparkle, outlined so it reads over the badge corner -->
    <path
        android:pathData="M75,25 C75.7,30 77,31.3 82,32 C77,32.7 75.7,34 75,39 C74.3,34 73,32.7 68,32 C73,31.3 74.3,30 75,25 Z"
        android:strokeColor="#080A06"
        android:strokeLineJoin="round"
        android:strokeWidth="3" />
    <path
        android:fillColor="#F2FFD0"
        android:pathData="M75,25 C75.7,30 77,31.3 82,32 C77,32.7 75.7,34 75,39 C74.3,34 73,32.7 68,32 C73,31.3 74.3,30 75,25 Z" />
</vector>
